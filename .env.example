# Slack app credentials (see README for the Slack app setup)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
PAPERBOT_CHANNEL_ID=C0123456789

OPENAI_API_KEY=sk-your-openai-key
# Mini-class models are the default cost-control choice for routine summaries.
OPENAI_MODEL=gpt-5-mini

# Required by Unpaywall for DOI lookups. Use a real email per their API policy.
UNPAYWALL_EMAIL=you@example.com

# Set to 1 to test the pipeline with placeholder summaries (no OpenAI cost).
PAPERBOT_DRY_RUN=0
PAPERBOT_POST_FAILURES=1
PAPERBOT_DB_PATH=paperbot.sqlite3
