# ---- Core (needed in every mode) ----
SLACK_BOT_TOKEN=xoxb-your-bot-token
PAPERBOT_CHANNEL_ID=C0123456789

OPENAI_API_KEY=sk-your-openai-key
# Mini-class models are the default cost-control choice for routine summaries.
OPENAI_MODEL=gpt-5-mini

# Required by Unpaywall. Use a real email per their API policy.
UNPAYWALL_EMAIL=you@example.com

PAPERBOT_DRY_RUN=0
PAPERBOT_POST_FAILURES=1

# ---- Socket Mode only (local / launchd; `paperbot`) ----
SLACK_APP_TOKEN=xapp-your-app-token
PAPERBOT_DB_PATH=paperbot.sqlite3

# ---- Serverless webhook only (Vercel; api/) ----
# Slack request-signing secret (Basic Information -> App Credentials)
SLACK_SIGNING_SECRET=your-slack-signing-secret
# Full URL of the deployed worker function (set after first deploy)
PAPERBOT_PROCESS_URL=https://your-app.vercel.app/api/process
# Upstash QStash (queue) credentials
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-qstash-current-key
QSTASH_NEXT_SIGNING_KEY=your-qstash-next-key
# Upstash Redis (dedup store) REST credentials
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-rest-token
