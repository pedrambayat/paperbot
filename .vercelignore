# Keep large/dev-only files out of the deployment upload.
.venv
.venv312
__pycache__
*.pyc
.pytest_cache
.git
tests
deploy
scripts
paperbot.egg-info
*.sqlite3
.env

# Keep pyproject out of the Vercel build: its [project]/[build-system] makes
# Vercel auto-detect a single Python app instead of the api/ serverless
# functions. Local dev still uses it; the functions get deps from requirements.txt.
pyproject.toml
